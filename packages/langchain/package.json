{
  "name": "@boswell/langchain",
  "version": "1.0.0",
  "description": "LangChain TypeScript 学习与实验项目 — RAG 系统",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "tsx --env-file=.env src/rag/cli.ts",
    "dev": "tsx watch --env-file=.env src/rag/cli.ts",
    "web": "tsx --env-file=.env src/server/index.ts",
    "web:dev": "tsx watch --env-file=.env src/server/index.ts",
    "rag:index": "tsx --env-file=.env src/rag/cli.ts index",
    "rag:query": "tsx --env-file=.env src/rag/cli.ts query",
    "rag:ask": "tsx --env-file=.env src/rag/cli.ts ask",
    "rag:stats": "tsx --env-file=.env src/rag/cli.ts stats",
    "rag:clear": "tsx --env-file=.env src/rag/cli.ts clear",
    "build": "tsc",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "langchain",
    "llm",
    "ai",
    "rag"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.1",
    "@langchain/deepseek": "^1.1.3",
    "commander": "^12.1.0",
    "express": "^5.2.1",
    "langchain": "^1.5.2",
    "pdf-parse": "^1.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0"
  }
}
