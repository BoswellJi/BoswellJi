{
  "$schema": "https://www.schemastore.org/package.json",
  "version": "1.0.4",
  "private": true,
  "description": "Personal practice",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "scripts": {
    "release:major": "commit-and-tag-version --release-as major --skip.changelog",
    "release:minor": "commit-and-tag-version --release-as minor --skip.changelog",
    "release:patch": "commit-and-tag-version --release-as patch --skip.changelog",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -r 0",
    "format:md": "prettier --write \"**/*.md\" --ignore-unknown",
    "format:md:check": "prettier --check \"**/*.md\" --ignore-unknown",
    "format:all": "prettier --write . --ignore-unknown",
    "blog": "pnpm --filter @boswell/blog dev",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "commit-msg": "node build/verifyCommit.js"
  },
  "lint-staged": {
    "*.{js,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "eslint --fix ",
      "prettier --parser=typescript --write"
    ],
    "*.md": [
      "prettier --write --prose-wrap preserve"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "commit-and-tag-version": "^13.1.2",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "eslint": "^8.56.0",
    "lint-staged": "^15.2.0",
    "picocolors": "^1.0.0",
    "prettier": "^3.1.1",
    "simple-git-hooks": "^2.9.0",
    "typescript": "^5.9.3"
  }
}
