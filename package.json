{
  "$schema": "https://www.schemastore.org/package.json",
  "version": "0.0.1",
  "private": true,
  "description": "个人练习",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "scripts": {
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md",
    "format:md": "prettier --write \"**/*.md\" --ignore-unknown",
    "format:md:check": "prettier --check \"**/*.md\" --ignore-unknown",
    "format:all": "prettier --write . --ignore-unknown",
    "blog": "pnpm --filter @boswell/blog dev",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "commit-msg": "node build/verifyCommit.js"
  },
  "lint-staged": {
    "*.{js,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "eslint --fix ",
      "prettier --parser=typescript --write"
    ],
    "*.md": [
      "prettier --write --prose-wrap preserve"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "eslint": "^8.56.0",
    "lint-staged": "^15.2.0",
    "picocolors": "^1.0.0",
    "prettier": "^3.1.1",
    "simple-git-hooks": "^2.9.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}
